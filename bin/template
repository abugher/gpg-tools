# in bin/, and extend it.  See further comments for recommended additions.


# Add library names, without the '.sh' suffix, here.
libs=(
  'utilities'
  'gpg-generic'
)


self_path="$(readlink -m "${0}")"
project_dir="${self_path%/bin/*}"
if ! cd "${project_dir}"; then
  printf '%s\n' 'Error:  Failed to enter project directory.'
  exit 1
fi


if ! source lib/source_libraries.sh; then
  printf '%s\n' 'Error:  Failed to source libraries.'
  exit 1
fi


function main() {
  # Write new code here, using the functions defined in the libraries.
}


main "${@}"
